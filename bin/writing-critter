#!/usr/bin/env python3
"""Writing Critter — counting engine.

Runs OUTSIDE the desktop shell, on purpose. An earlier version did this work
inside quickshell and segfaulted the whole desktop in a crash loop; see
docs/POSTMORTEM-ORPHANED-READ.md. Here, a bug is a dead script.

Standard library only. Readable on purpose too: this reads your documents, so
you should be able to audit it without trusting a dependency tree.
"""

from __future__ import annotations

import argparse
import contextlib
import copy
import fcntl
import json
import os
import re
import select
import socket
import stat
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

VERSION = "0.1.0"

# ----------------------------------------------------------------- paths


def _xdg(var: str, default: str) -> Path:
    raw = os.environ.get(var, "").strip()
    return Path(raw) if raw else Path.home() / default


CONFIG_PATH = _xdg("XDG_CONFIG_HOME", ".config") / "writing-critter" / "config.json"
STATE_PATH = _xdg("XDG_STATE_HOME", ".local/state") / "writing-critter" / "state.json"
# Per-file bookkeeping lives apart from state.json on purpose. It is the bulk of
# the data (267 files was 99% of a real state file) and it holds the path of
# every note, so keeping it here means the bar widget neither parses it nor ever
# holds the user's note titles in the desktop shell process.
TRACKING_PATH = STATE_PATH.with_name("tracking.json")

# ----------------------------------------------------------------- config

# Kept in step with MASCOTS in Model.js. The widget falls back on an unknown
# mascot rather than rendering nothing, but there is no reason to write one.
MASCOTS = ("bird", "snail")

# How often an idle engine refreshes updatedAt so readers can tell it is alive.
# Readers treat silence past ~90s as stopped; see docs/STATE-FILE.md.
HEARTBEAT_SECONDS = 30

DEFAULTS: dict[str, Any] = {
    "goal": 500,
    "watch": [],
    "extensions": [".md", ".txt"],
    "whitelist": [
        "omawrite",
        "obsidian",
        "typora",
        "soffice",
        "libreoffice-writer",
        "ghostwriter",
        "apostrophe",
    ],
    "graceSeconds": 15,
    # One second, not two. Two independent polls sit in series between a save
    # and the bar -- this one and the widget's own read of state.json -- so the
    # perceived delay is the sum, and halving each halves the sum. A scan is an
    # os.scandir with an mtime filter; on a 267-note vault it is well under a
    # millisecond of work per tick.
    "pollSeconds": 1,
    "lookbackSeconds": 3,
    "recountCap": 200,
    "netMode": "additive",
    "mascot": "bird",
}

POLL_MIN, POLL_MAX = 1, 30
HISTORY_MAX = 365


class ConfigError(Exception):
    """Raised when the config file exists but cannot be used."""


@dataclass
class Config:
    path: Path
    # deepcopy, not dict(): a shallow copy aliases the list values, so appending
    # a watch path would mutate DEFAULTS itself and leak into every later load.
    values: dict[str, Any] = field(default_factory=lambda: copy.deepcopy(DEFAULTS))

    @classmethod
    def load(cls, path: Path = CONFIG_PATH) -> "Config":
        cfg = cls(path=path)
        if not path.exists():
            return cfg
        try:
            raw = json.loads(path.read_text())
        except json.JSONDecodeError as exc:
            # Never rewrite a file we could not parse: the user's settings are
            # in there, and overwriting them with defaults would be worse than
            # refusing to start.
            raise ConfigError(f"{path}: invalid JSON at line {exc.lineno}, column {exc.colno}: {exc.msg}")
        if not isinstance(raw, dict):
            raise ConfigError(f"{path}: expected a JSON object, found {type(raw).__name__}")
        unknown = sorted(set(raw) - set(DEFAULTS))
        if unknown:
            raise ConfigError(f"{path}: unknown setting(s): {', '.join(unknown)}")
        cfg.values.update(raw)
        cfg.validate()
        return cfg

    def mtime(self) -> float:
        """The config file's mtime, or 0 when it does not exist."""
        try:
            return self.path.stat().st_mtime
        except OSError:
            return 0.0

    def validate(self) -> None:
        v = self.values
        if not isinstance(v["goal"], int) or v["goal"] < 1:
            raise ConfigError(f"{self.path}: 'goal' must be a positive integer")
        if v["mascot"] not in MASCOTS:
            raise ConfigError(f"{self.path}: 'mascot' must be one of {', '.join(MASCOTS)}")
        for key in ("watch", "extensions", "whitelist"):
            if not isinstance(v[key], list) or not all(isinstance(x, str) for x in v[key]):
                raise ConfigError(f"{self.path}: '{key}' must be a list of strings")
        if v["netMode"] not in ("additive", "net"):
            raise ConfigError(f"{self.path}: 'netMode' must be 'additive' or 'net'")

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(self.path, json.dumps(self.values, indent=2, sort_keys=True) + "\n")

    # convenience accessors -------------------------------------------------
    @property
    def poll_seconds(self) -> int:
        return max(POLL_MIN, min(POLL_MAX, int(self.values["pollSeconds"])))

    @property
    def lookback_seconds(self) -> int:
        """Must exceed the poll interval or a save on a tick boundary is missed."""
        want = int(self.values["lookbackSeconds"])
        return want if want > self.poll_seconds else self.poll_seconds + 1

    @property
    def watch_paths(self) -> list[Path]:
        return [Path(os.path.expanduser(p)) for p in self.values["watch"]]


# ----------------------------------------------------------------- atomic io


@contextlib.contextmanager
def config_lock(path: Path):
    """Serialise read-modify-write of the config file across processes.

    Until the bar panel could change settings, the only writer was a human
    typing one command at a time and this was unnecessary. Now two clicks a
    tenth of a second apart are two processes, each doing load -> mutate ->
    save, and without this the second silently discards the first's change.

    The lock lives in a sibling file rather than on the config itself. Saving
    replaces the config by rename, so a lock taken on its inode is orphaned the
    moment the first writer finishes -- a second and third writer would then be
    holding locks on two different inodes and excluding nobody. The lock file is
    only ever created, never replaced, so its inode is stable. This is the same
    trap that orphaned the widget's file watch; see docs/STATE-FILE.md.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path.with_name(path.name + ".lock"), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        # Closing releases the lock, on every path out including an exception.
        os.close(fd)


def write_atomic(path: Path, text: str) -> None:
    """Write via temporary file and rename, so a reader never sees a torn file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# ----------------------------------------------------------------- logging


class Log:
    """Every decision, on stdout, in order. The previous implementation was
    undiagnosable precisely because it made decisions silently."""

    def __init__(self, enabled: bool = True) -> None:
        self.enabled = enabled

    def __call__(self, event: str, **fields: Any) -> None:
        if not self.enabled:
            return
        stamp = time.strftime("%H:%M:%S")
        detail = " ".join(f"{k}={v}" for k, v in fields.items())
        print(f"{stamp} {event}" + (f"  {detail}" if detail else ""), flush=True)


# ----------------------------------------------------------------- counting

# CJK scripts do not delimit words with spaces, so whitespace splitting would
# score a whole paragraph as one word. Counting each ideograph overshoots -- most
# words are one or two characters -- but it is stable and predictable, which
# matters more for a progress bar than linguistic accuracy. Documented as a
# known approximation.
CJK = re.compile(
    "[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uff66-\uff9f]"
)


def count_words(text: str) -> int:
    if not text:
        return 0
    cjk = len(CJK.findall(text))
    return len(CJK.sub(" ", text).split()) + cjk


@dataclass
class FileRecord:
    """base  — word count when the day started, or when first seen
    last  — most recently observed count
    peak  — high-water mark of (last - base) today"""

    base: int
    last: int
    peak: int = 0


class Tracker:
    """Today's total is the sum of per-file high-water marks.

    That is re-derived from stored numbers rather than accumulated, so counting
    an unchanged file twice is a no-op and an overlapping scan window cannot
    double-count. The high-water mark also means cutting a paragraph never takes
    back progress already earned -- a counter that falls when you edit teaches
    you not to edit.
    """

    def __init__(self, files: dict[str, FileRecord] | None = None) -> None:
        self.files: dict[str, FileRecord] = files or {}

    def seed(self, path: str, words: int) -> None:
        """Record a pre-existing file's count as its baseline, contributing zero.

        This is how pointing the engine at a vault full of old notes adds
        nothing to today. It is deliberately separate from observe(): a file
        that appears *after* seeding was written while we were watching, and
        every word of it counts.
        """
        words = max(0, int(words))
        if path not in self.files:
            self.files[path] = FileRecord(base=words, last=words, peak=0)

    def observe(self, path: str, words: int, net_mode: str = "additive") -> None:
        words = max(0, int(words))
        record = self.files.get(path)
        if record is None:
            # Unseen at this point means created since seeding: you wrote it, so
            # all of it counts. Pre-existing files were given a baseline by
            # seed() before the first cycle ran.
            self.files[path] = FileRecord(base=0, last=words, peak=words if net_mode != "net" else words)
            return
        record.last = words
        delta = words - record.base
        if net_mode == "net":
            record.peak = delta
        else:
            record.peak = max(record.peak, delta, 0)

    def forget(self, path: str) -> None:
        self.files.pop(path, None)

    def rebase(self, path: str) -> None:
        record = self.files.get(path)
        if record is not None:
            record.base, record.peak = record.last, 0

    def total(self) -> int:
        return max(0, sum(r.peak for r in self.files.values()))

    def carry_forward(self) -> "Tracker":
        """New day: today's counts become tomorrow's baselines."""
        return Tracker({p: FileRecord(base=r.last, last=r.last, peak=0) for p, r in self.files.items()})

    def to_json(self) -> dict[str, list[int]]:
        return {p: [r.base, r.last, r.peak] for p, r in self.files.items()}

    @classmethod
    def from_json(cls, raw: Any) -> "Tracker":
        files: dict[str, FileRecord] = {}
        if isinstance(raw, dict):
            for path, triple in raw.items():
                if isinstance(triple, list) and len(triple) == 3 and all(isinstance(n, int) for n in triple):
                    files[path] = FileRecord(*triple)
        return cls(files)


def scan(paths: list[Path], extensions: list[str], cutoff: float, log: Log) -> list[Path]:
    """Metadata-only: stat every candidate, read none.

    Deliberately in-process. The previous version shelled out to `find` with a
    relative timestamp, which GNU findutils accepts and bfs -- what Omarchy
    ships -- rejects outright, so the scan errored every cycle and counted
    nothing, silently.
    """
    suffixes = tuple(extensions)
    changed: list[Path] = []

    # os.scandir over os.walk + Path(): DirEntry carries stat data from the
    # directory read, and building a Path per candidate cost more than the scan
    # itself. This loop runs every couple of seconds forever, so it is worth it.
    def descend(directory: str) -> None:
        try:
            entries = list(os.scandir(directory))
        except OSError as exc:
            log("scan.failed", path=directory, error=exc)
            return
        for entry in entries:
            try:
                if entry.is_dir(follow_symlinks=False):
                    if not entry.name.startswith(".") and entry.name != "node_modules":
                        descend(entry.path)
                elif entry.name.endswith(suffixes) and entry.stat().st_mtime > cutoff:
                    changed.append(Path(entry.path))
            except OSError as exc:
                log("scan.stat_failed", path=entry.path, error=exc)

    for root in paths:
        descend(str(root))
    return changed


# ----------------------------------------------------------------- focus
#
# The ONLY compositor-specific code in the engine. Everything else works from
# the plain app-id string this yields, so porting to another compositor means
# replacing this class and nothing else.
#
# Requires Hyprland. Omarchy is Hyprland, so the practical cost is nil. The
# in-shell version used Wayland's ToplevelManager, which does not exist outside
# quickshell -- and the event stream is the better fit anyway: it costs nothing
# while idle, where the old design needed a polling fallback.


class HyprlandFocus:
    EVENT = "activewindow>>"

    def __init__(self, log: Log) -> None:
        self.log = log
        self._buffer = ""

    def socket_path(self) -> Path | None:
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not runtime or not signature:
            return None
        candidate = Path(runtime) / "hypr" / signature / ".socket2.sock"
        return candidate if candidate.exists() else None

    def current(self) -> str:
        """Focus at startup.

        Without this the engine never starts when it is launched with the editor
        already focused: no transition arrives, so an event-only design waits
        forever. That exact bug shipped in the in-shell version.
        """
        try:
            out = subprocess.run(
                ["hyprctl", "activewindow", "-j"],
                capture_output=True, text=True, timeout=5, check=False,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            self.log("focus.query_failed", error=exc)
            return ""
        if out.returncode != 0:
            self.log("focus.query_failed", status=out.returncode, stderr=out.stderr.strip()[:120])
            return ""
        try:
            return str(json.loads(out.stdout or "{}").get("class", "") or "")
        except json.JSONDecodeError:
            self.log("focus.query_unparseable")
            return ""

    def connect(self) -> socket.socket | None:
        """Open the event stream. Returned so the caller can select() on it and
        drive its own cadence from the same loop -- no threads, no polling."""
        path = self.socket_path()
        if path is None:
            self.log("focus.no_socket", hint="HYPRLAND_INSTANCE_SIGNATURE unset or socket missing")
            return None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(str(path))
        self._buffer = ""
        return sock

    def drain(self, sock: socket.socket) -> list[str]:
        """Return the app id from each focus change now readable, in order."""
        chunk = sock.recv(65536)
        if not chunk:
            raise ConnectionError("hyprland event stream closed")
        self._buffer += chunk.decode("utf-8", errors="replace")
        out = []
        while "\n" in self._buffer:
            line, self._buffer = self._buffer.split("\n", 1)
            if line.startswith(self.EVENT):
                # "activewindow>>CLASS,TITLE"; a title may itself contain commas.
                out.append(line[len(self.EVENT):].split(",", 1)[0])
        return out


# ----------------------------------------------------------------- matching
#
# Wayland app ids are often reverse-DNS ("md.obsidian.Obsidian") while people
# think in short names ("obsidian"). Exact matching means a whitelist that looks
# obviously correct silently matches nothing and the critter never wakes -- the
# real bug that made the in-shell version look broken for a whole session.


def app_matches(entry: str, app_id: str) -> bool:
    if not entry or not app_id:
        return False
    e, a = entry.lower(), app_id.lower()
    if e == a:
        return True
    if "." in e:
        return False  # a dotted entry is a deliberate exact match
    _, dot, leaf = a.rpartition(".")
    return bool(dot) and leaf == e


def app_in_list(entries: list[str], app_id: str) -> bool:
    return any(app_matches(e, app_id) for e in entries)


# ----------------------------------------------------------------- engine


class Engine:
    def __init__(self, config: Config, log: Log) -> None:
        self.config = config
        self.log = log
        self.focused_app: str = ""
        # The most recent focused app that is NOT whitelisted. Published so the
        # bar can offer it as a one-tap addition: the appId Hyprland matches on
        # is a reverse-DNS string like "md.obsidian.Obsidian", which nobody
        # guesses and which cost real debugging time to discover by hand.
        #
        # One value, never a list, and no timestamps. A history of what was
        # focused and when is an activity log, and this plugin does not keep one.
        self.last_uncounted_app: str = ""
        self.last_writing_at: float = 0.0
        self._gate_open: bool = False
        self.state_path = STATE_PATH  # setter derives tracking_path
        self.today: str = local_date()
        self.history: list[dict[str, Any]] = []
        self.tracker: Tracker = Tracker()
        self.words: int = 0

    @property
    def state_path(self) -> Path:
        return self._state_path

    @state_path.setter
    def state_path(self, path: Path) -> None:
        """Setting the state path always moves the tracking file with it.

        These were two independent attributes once, and a test that redirected
        only state_path wrote its bookkeeping into the real ~/.local/state.
        """
        self._state_path = path
        self.tracking_path = path.with_name("tracking.json")

    # ---- the gate: the whole activation model, a pure function of focus ----

    def writing_focused(self) -> bool:
        return app_in_list(self.config.values["whitelist"], self.focused_app)

    def gate_open(self, now: float | None = None) -> bool:
        """Open while a writing app is focused, or was within the grace window.

        The grace exists because editors autosave a beat after focus leaves; a
        strict gate drops the save that finishes just after you alt-tab.
        """
        if self.blocking_reason():
            return False
        if self.writing_focused():
            return True
        now = time.time() if now is None else now
        grace = float(self.config.values["graceSeconds"])
        return self.last_writing_at > 0 and (now - self.last_writing_at) < grace

    def set_focus(self, app_id: str, now: float | None = None) -> bool:
        """Record a focus change. Returns True if the gate state changed."""
        now = time.time() if now is None else now
        was_open = self._gate_open
        moved = app_id != self.focused_app
        self.focused_app = app_id
        if self.writing_focused():
            self.last_writing_at = now
        elif app_id:
            self.last_uncounted_app = app_id
        self._gate_open = self.gate_open(now)
        if self._gate_open != was_open:
            self.log("gate." + ("open" if self._gate_open else "closed"), app=app_id or "(none)")
            return True
        # Hyprland re-emits activewindow on title changes, and editors rewrite
        # their title as you type. Only an actual change of app is worth a line.
        if moved:
            state = "open" if self._gate_open else "closed"
            if self._gate_open and not self.writing_focused():
                state = "open (grace)"
            self.log("focus.change", app=app_id or "(none)", gate=state)
        return False

    def candidate_app(self) -> str:
        """The uncounted app worth offering, or "" when there is none.

        Checked at publish rather than on config reload so that whitelisting the
        candidate -- by any route, including a terminal -- retires it without
        the reload path having to remember to.
        """
        if self.last_uncounted_app and app_in_list(
                self.config.values["whitelist"], self.last_uncounted_app):
            self.last_uncounted_app = ""
        return self.last_uncounted_app

    def refresh_gate(self, now: float | None = None) -> bool:
        """Re-evaluate without a focus change, so the grace window can expire."""
        now = time.time() if now is None else now
        was_open = self._gate_open
        self._gate_open = self.gate_open(now)
        if self._gate_open != was_open:
            self.log("gate." + ("open" if self._gate_open else "closed"), reason="grace expired")
        return self._gate_open

    # ------------------------------------------------------------- state

    def load_state(self, path: Path = None) -> None:
        path = STATE_PATH if path is None else path
        self.state_path = path
        raw = read_state(path) or {}
        self.today = str(raw.get("date") or local_date())
        self.history = raw.get("history") if isinstance(raw.get("history"), list) else []
        tracking = read_state(self.tracking_path)
        if tracking is None:
            # Upgrade from the single-file layout: without this the tracker
            # starts empty, seed_baselines rebaselines every file, and today's
            # count silently resets to zero.
            tracking = raw.get("tracking")
        self.tracker = Tracker.from_json(tracking)
        self.words = self.tracker.total()
        self.check_rollover()

    def write_state(self, include_tracking: bool = True) -> None:
        """Publish state. `include_tracking` is False for a heartbeat, which
        only needs to refresh updatedAt: the bookkeeping file is the large one
        and rewriting it every half minute buys nothing."""
        payload = {
            "schema": 1,
            "date": self.today,
            "goal": int(self.config.values["goal"]),
            "wordsToday": self.words,
            "byOrigin": {"filewatch": self.words},
            "history": self.history[-HISTORY_MAX:],
            "mascot": self.config.values["mascot"],
            "gateOpen": self._gate_open,
            "lastFocusedApp": self.candidate_app(),
            "updatedAt": time.time(),
        }
        write_atomic(self.state_path, json.dumps(payload, indent=2, sort_keys=True) + "\n")
        if include_tracking:
            write_atomic(self.tracking_path,
                         json.dumps(self.tracker.to_json(), indent=2, sort_keys=True) + "\n")

    def check_rollover(self, today: str | None = None) -> bool:
        today = local_date() if today is None else today
        if today == self.today:
            return False
        self.history = (self.history + [
            {"date": self.today, "words": self.words, "goal": int(self.config.values["goal"])}
        ])[-HISTORY_MAX:]
        # Baselines carry forward, so yesterday's words are never re-counted and
        # no file has to be re-read at midnight.
        self.tracker = self.tracker.carry_forward()
        self.today = today
        self.words = 0
        self.log("day.rollover", date=today, archived=len(self.history))
        return True

    def seed_baselines(self) -> int:
        """Give every file already on disk a baseline, so existing writing is
        not counted as today's. Runs once at startup; a file appearing after
        this counts in full."""
        seeded = 0
        for path in scan(self.config.watch_paths, self.config.values["extensions"], -1.0, self.log):
            key = str(path)
            if key in self.tracker.files:
                continue
            try:
                self.tracker.seed(key, count_words(path.read_text(errors="replace")))
                seeded += 1
            except OSError as exc:
                self.log("seed.read_failed", path=path, error=exc)
        if seeded:
            self.log("seed.baselines", files=seeded)
        return seeded

    # ------------------------------------------------------------- cycle

    def cycle(self) -> bool:
        """Count what changed. Returns True if state was published.

        The caller needs to know: it drives the heartbeat off the last real
        publish, and a cycle that found nothing has not proved anything.
        """
        self.check_rollover()
        cutoff = time.time() - self.config.lookback_seconds
        changed = scan(self.config.watch_paths, self.config.values["extensions"], cutoff, self.log)
        if not changed:
            return False

        cap = int(self.config.values["recountCap"])
        if len(changed) > cap:
            # Bound a pathological cycle: a branch switch or a bulk import
            # inside a watch directory must not turn one tick into thousands of
            # reads.
            self.log("cycle.capped", found=len(changed), cap=cap)
            changed = changed[:cap]

        before = self.words
        for path in changed:
            try:
                text = path.read_text(errors="replace")
            except OSError as exc:
                self.log("cycle.read_failed", path=path, error=exc)
                continue
            self.tracker.observe(str(path), count_words(text), self.config.values["netMode"])

        self.words = self.tracker.total()
        self.write_state()
        if self.words != before:
            self.log("words.counted", added=self.words - before, today=self.words,
                     goal=self.config.values["goal"], files=len(changed))
        return True

    def blocking_reason(self) -> str | None:
        """Why counting cannot happen right now, or None if it can."""
        if not self.config.values["watch"]:
            return "no watch paths configured (writing-critter config add-path <dir>)"
        if not self.config.values["whitelist"]:
            return "no writing apps configured (writing-critter config add-app <id>)"
        return None


# ----------------------------------------------------------------- commands


def cmd_run(args: argparse.Namespace) -> int:
    config = Config.load(args.config)
    log = Log(enabled=True)
    engine = Engine(config, log)
    log("engine.start", version=VERSION, config=config.path, state=STATE_PATH)

    blocked = engine.blocking_reason()
    engine.load_state()
    if blocked:
        # A fresh setup has no path until the user finishes configuring the
        # panel. That is a valid idle state, not a process fault: returning 1
        # makes the systemd unit restart-loop and leaves the panel unable to
        # present setup as successful.
        log("engine.idle", reason=blocked)
    else:
        engine.seed_baselines()
    config_mtime = config.mtime()
    focus = HyprlandFocus(log)
    engine.set_focus(focus.current())
    # Publish once before waiting on the socket. Readers use updatedAt to tell a
    # live engine from a stopped one, and a cycle only writes when a file
    # changed - so without this the state looks stale from every restart until
    # the user happens to type, and the critter reads as dead while it is fine.
    engine.write_state()
    last_publish = time.time()
    last_cycle = 0.0
    log("engine.ready", goal=config.values["goal"], paths=len(config.watch_paths),
        poll=config.poll_seconds, lookback=config.lookback_seconds)

    sock = focus.connect()
    if sock is None:
        print("\nno Hyprland event socket; is HYPRLAND_INSTANCE_SIGNATURE set?", file=sys.stderr)
        return 1

    # One loop drives both: focus events wake it, and the select timeout
    # provides the counting cadence. No threads, and nothing polls the
    # compositor.
    try:
        with sock:
            while True:
                readable, _, _ = select.select([sock], [], [], config.poll_seconds)

                # Checked on every wake, not only on a timeout tick. Hyprland
                # re-emits activewindow when a window's title changes and
                # editors rewrite their title as you type, so a stream of focus
                # events could otherwise starve this branch for as long as you
                # kept writing. It is one stat().
                #
                # Pick up "config add-path" without a restart. Writing the
                # file and having the running engine ignore it is how a working
                # tool looks broken.
                seen = config.mtime()
                if seen != config_mtime:
                    config_mtime = seen
                    try:
                        config = Config.load(args.config)
                    except ConfigError as exc:
                        # A half-written file mid-edit must not kill the service.
                        log("config.reload_failed", error=exc)
                    else:
                        engine.config = config
                        log("config.reloaded", paths=len(config.watch_paths),
                            goal=config.values["goal"])
                        blocked = engine.blocking_reason()
                        if blocked:
                            log("engine.idle", reason=blocked)
                        else:
                            # Baseline whatever just became visible, or every word
                            # already in a newly watched vault counts as written today.
                            engine.seed_baselines()
                        # The current focus was captured at startup. Recompute
                        # from it so adding the first path immediately reflects
                        # whether the engine is awake, without a service restart.
                        engine.refresh_gate()
                        # Publish at once. Goal and mascot are user-visible and
                        # have just changed; without this the new value reaches
                        # the bar only on the next counted cycle or the next
                        # heartbeat, so a click in the panel could take half a
                        # minute to show up and read as broken.
                        engine.write_state()
                        last_publish = time.time()

                if readable:
                    for app_id in focus.drain(sock):
                        if engine.set_focus(app_id):
                            # The gate just opened or closed, and gateOpen is
                            # what tells the bar whether the critter is awake.
                            # Publishing here rather than waiting for the next
                            # cycle is the difference between the critter
                            # waking as you focus your editor and waking a few
                            # seconds later for no visible reason.
                            engine.write_state(include_tracking=False)
                            last_publish = time.time()

                # Cadence is measured from the last cycle, not from what woke
                # the loop. This used to `continue` on any focus event, so a
                # burst of them skipped counting entirely -- and Hyprland emits
                # activewindow on title changes, which editors make as you
                # type. Measured on a live session: five events in fifteen
                # seconds, half the gaps shorter than one poll interval, so
                # roughly half the ticks never counted anything.
                now = time.time()
                if now - last_cycle >= config.poll_seconds:
                    last_cycle = now
                    if engine.refresh_gate() and engine.cycle():
                        last_publish = now
                # A cycle only publishes when a file changed, so a reader
                # watching updatedAt would call a healthy but idle engine
                # "stopped" within a couple of minutes of the last word. The
                # heartbeat is what makes that field mean what the contract
                # says it means. State is tiny; tracking is not, and is skipped.
                #
                # This is deliberately not an `elif` on the gate, and the clock
                # only advances on a real publish. It used to be both, which
                # meant an open gate reset the timer every tick while writing
                # nothing: sit in your editor reading for ninety seconds and the
                # bar called a perfectly healthy engine stopped.
                if now - last_publish >= HEARTBEAT_SECONDS:
                    engine.write_state(include_tracking=False)
                    last_publish = now
    except ConnectionError as exc:
        log("engine.stop", reason=exc)
        return 1
    except KeyboardInterrupt:
        log("engine.stop", reason="interrupted")
        return 0


def cmd_status(args: argparse.Namespace) -> int:
    config = Config.load(args.config)
    state = read_state()

    goal = config.values["goal"]
    words = int(state.get("wordsToday", 0)) if state else 0
    print(f"words today   {words} / {goal}")
    print(f"config        {config.path}")
    print(f"state         {STATE_PATH}" + ("" if state else "  (not written yet)"))

    paths = config.values["watch"]
    print(f"watching      {', '.join(paths) if paths else '(nothing)'}")
    print(f"writing apps  {', '.join(config.values['whitelist'])}")

    if state and "updatedAt" in state:
        age = int(time.time() - float(state["updatedAt"]))
        fresh = "running" if age < 60 else f"stale ({age}s since last update)"
        print(f"engine        {fresh}")
    else:
        print("engine        not running")

    engine = Engine(config, Log(enabled=False))
    blocked = engine.blocking_reason()
    if blocked:
        print(f"\nnot counting: {blocked}")
    return 0


def local_date() -> str:
    return time.strftime("%Y-%m-%d")


def read_state(path: Path = None) -> dict[str, Any] | None:
    """Readers tolerate a missing or torn file; neither is an error."""
    try:
        return json.loads((STATE_PATH if path is None else path).read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def cmd_config(args: argparse.Namespace) -> int:
    # Reads need no lock: save() renames into place, so a reader sees a whole
    # file either way.
    if args.config_action == "show":
        print(json.dumps(Config.load(args.config).values, indent=2, sort_keys=True))
        return 0

    if args.config_action == "path":
        print(Config.load(args.config).path)
        return 0

    # Everything below mutates. Load inside the lock, not before it: a config
    # read outside would be stale by the time the lock was granted.
    with config_lock(args.config):
        config = Config.load(args.config)
        return _config_mutate(args, config)


def _config_mutate(args: argparse.Namespace, config: Config) -> int:
    """Apply one mutating config action. Always called holding config_lock."""
    # Scalars. The panel can now change these, but only by invoking this
    # command: the engine stays the single writer of the config file.
    if args.config_action == "set-goal":
        try:
            goal = int(args.value)
        except ValueError:
            print(f"goal must be a whole number of words, not {args.value!r}", file=sys.stderr)
            return 1
        config.values["goal"] = goal
        config.validate()
        config.save()
        print(f"goal: {goal} words/day")
        return 0

    if args.config_action == "set-poll":
        try:
            seconds = int(args.value)
        except ValueError:
            print(f"poll must be a whole number of seconds, not {args.value!r}", file=sys.stderr)
            return 1
        if not POLL_MIN <= seconds <= POLL_MAX:
            print(f"poll must be between {POLL_MIN} and {POLL_MAX} seconds", file=sys.stderr)
            return 1
        config.values["pollSeconds"] = seconds
        config.validate()
        config.save()
        print(f"poll: every {seconds}s")
        return 0

    if args.config_action == "set-mascot":
        known = sorted(MASCOTS)
        if args.value not in known:
            print(f"unknown mascot {args.value!r}; choose from: {', '.join(known)}", file=sys.stderr)
            return 1
        config.values["mascot"] = args.value
        config.validate()
        config.save()
        print(f"mascot: {args.value}")
        return 0

    key = {"add-path": "watch", "remove-path": "watch",
           "add-app": "whitelist", "remove-app": "whitelist"}[args.config_action]
    value = args.value
    if args.config_action.startswith("add"):
        if key == "watch":
            value = str(Path(os.path.expanduser(value)).resolve())
        if value in config.values[key]:
            print(f"already present: {value}")
            return 0
        config.values[key].append(value)
    else:
        if key == "watch":
            candidates = {value, str(Path(os.path.expanduser(value)).resolve())}
            before = list(config.values[key])
            config.values[key] = [p for p in before if p not in candidates]
            if config.values[key] == before:
                print(f"not present: {value}", file=sys.stderr)
                return 1
        else:
            if value not in config.values[key]:
                print(f"not present: {value}", file=sys.stderr)
                return 1
            config.values[key].remove(value)

    config.validate()
    config.save()
    print(f"{key}: {', '.join(config.values[key]) or '(empty)'}")
    return 0


# ------------------------------------------------------- service management
#
# Omarchy clones a plugin and validates it; it deliberately runs no install
# hook. So adding this plugin gives you a bar widget with nothing behind it
# until the engine is copied out and its user service started. That step used
# to live only in install.sh, which meant discovering a terminal command that
# is not mentioned anywhere in the panel.
#
# It lives here rather than in the shell for the same reason the counting does.
# The panel asks for "install"; it does not get to say what to install or where
# to put it. Every path below is derived from this file's own location and the
# user's home, the systemd calls are literal argument lists built in this file,
# and there is no argument, config key, or environment variable that redirects
# any of them. What the panel can do is exactly what install.sh can do, because
# they are the same code -- that is the point of putting it here.
#
# Nothing in this section reads or writes config.json, state.json or
# tracking.json, with one exception: status reads state.json's timestamp to
# tell a service that is running from one that is merely loaded. Removing the
# engine removes the engine, not your writing history.

UNIT_NAME = "writing-critter.service"

# Bump only for an incompatible change to the status object. Model.js checks
# this and falls back to "unknown" rather than guessing at a shape it does not
# know; see parseServiceStatus there.
SERVICE_SCHEMA = 1

# The stable state vocabulary. The panel maps each of these to exactly one
# offered action, so adding a state here is a UI change too.
SERVICE_STATES = (
    "not-installed",    # one or both files absent -- offer setup
    "update-available", # installed files differ from this checkout
    "stopped",          # installed and current, not running
    "starting",         # active, but has not published state yet
    "unhealthy",        # active or failed, and not publishing
    "ready",            # active and publishing
)

# No systemctl call here does real work -- they reload units, flip symlinks and
# start one small process -- so a call still running after this long has hung on
# a busy or wedged user manager, and waiting longer only makes the panel look
# frozen.
SYSTEMCTL_TIMEOUT = 8

# The window StateSource.qml uses before it calls the engine stopped. Kept in
# step deliberately: if the bar says asleep, status must not say ready.
STATE_FRESH_SECONDS = 90

# A freshly started engine publishes within a second, but a loaded machine can
# take longer, and calling that "unhealthy" would offer a restart to something
# that is merely young. Applies only to a unit systemd reports as active.
STARTUP_GRACE_SECONDS = 20

# Captured output is bounded before it is parsed or reported. systemd is not
# expected to answer with a megabyte, which is exactly why nothing here assumes
# it will not.
SERVICE_OUTPUT_MAX = 8192
SERVICE_MESSAGE_MAX = 400

# How long to keep watching after a start or a restart before believing it.
#
# `systemctl restart` returns 0 for a Type=simple unit the moment the fork
# succeeds. If ExecStart cannot be executed at all, systemd finds out shortly
# afterwards -- so a single immediate re-read of ActiveState reports "active"
# for a unit that is already on its way into a crash loop, and an install that
# checked once called that a success.
#
# The numbers are measured, not guessed. On systemd 261, restarting a unit
# whose ExecStart does not exist: the command returned after 5-6ms, and the
# failure became visible at 34ms, 34ms and 59ms across three trials. The unit
# then sits in auto-restart for RestartSec (5s here) before trying again, so
# anything that looks after ~60ms and before ~5s sees it. This window clears
# the worst measured latency by about seven times and still costs under half a
# second on the path where everything is fine.
VERIFY_ATTEMPTS = 3
VERIFY_DELAY = 0.2

ENGINE_MODE = 0o755
UNIT_MODE = 0o644

# The installed engine's version, read out of the file rather than obtained by
# running it. Executing a binary to ask what it is means executing a binary you
# have already decided you are not sure about.
_VERSION_DECL = re.compile(r'^VERSION\s*=\s*"([0-9A-Za-z.+-]{1,32})"', re.M)
_VERSION_SCAN_BYTES = 8192


def _sanitize(text: str, limit: int = SERVICE_MESSAGE_MAX) -> str:
    """One line, printable, bounded. Everything here can end up in a bar panel."""
    cleaned = "".join(ch if ch.isprintable() else " " for ch in text)
    return " ".join(cleaned.split())[:limit]


@dataclass(frozen=True)
class ServicePaths:
    """Where the engine comes from and where it goes. Fixed, derived, unsettable.

    `engine` is $HOME/.local/bin deliberately, and not XDG_BIN_HOME as install.sh
    once used. The shipped unit runs %h/.local/bin/writing-critter -- a literal
    in a file this program also installs -- so honouring XDG_BIN_HOME put the
    binary somewhere the unit would never execute and reported success. One
    canonical location, named in one place, is the fix.
    """

    source_engine: Path
    source_unit: Path
    engine: Path
    unit: Path
    state: Path

    @classmethod
    def resolve(cls) -> "ServicePaths":
        here = Path(__file__).resolve()
        return cls(
            source_engine=here,
            source_unit=here.parent.parent / "contrib" / UNIT_NAME,
            engine=Path.home() / ".local" / "bin" / "writing-critter",
            unit=_xdg("XDG_CONFIG_HOME", ".config") / "systemd" / "user" / UNIT_NAME,
            state=STATE_PATH,
        )

    @property
    def source_available(self) -> bool:
        """True when this copy is the one in a plugin checkout.

        The copy under ~/.local/bin has no contrib/ beside it. It can report
        status and drive the service, but it cannot install: it has nothing to
        install from, and it must not be allowed to reinstall itself and call
        that an update.
        """
        return self.source_engine.is_file() and self.source_unit.is_file()


class Systemctl:
    """Every systemd call this program can make, written out one per method.

    There is no run(verb) taking a string, and no method takes a unit name: the
    unit is UNIT_NAME and the manager is --user, both literals in this file.
    A reviewer can read this class and enumerate the complete set of things
    this plugin can ask systemd to do, which is the only reason it is shaped
    this way rather than as one generic helper.
    """

    def __init__(self, timeout: float = SYSTEMCTL_TIMEOUT) -> None:
        self.timeout = timeout

    SHOW_PROPERTIES = (
        "LoadState",
        "ActiveState",
        "SubState",
        "UnitFileState",
        "ActiveEnterTimestampMonotonic",
        "Result",
        "NRestarts",
    )

    def _call(self, args: list[str]) -> tuple[bool, str, str]:
        """(ok, stdout, message). Never raises; a broken systemd is a state."""
        try:
            proc = subprocess.run(
                ["systemctl", "--user", *args],
                capture_output=True,
                text=True,
                timeout=self.timeout,
                check=False,
            )
        except FileNotFoundError:
            return False, "", "systemctl was not found"
        except subprocess.TimeoutExpired:
            return False, "", f"systemctl {args[0]} timed out after {self.timeout:g}s"
        except OSError as exc:
            return False, "", _sanitize(f"could not run systemctl: {exc}")
        out = proc.stdout[:SERVICE_OUTPUT_MAX]
        if proc.returncode == 0:
            return True, out, ""
        detail = _sanitize(proc.stderr) or _sanitize(out) or f"exited {proc.returncode}"
        return False, out, f"systemctl {args[0]}: {detail}"

    # `show` is the only reader, and it is the only one whose exit code carries
    # no information: it returns 0 for a unit that does not exist, which is
    # exactly why the parser can tell absent from unaskable. See
    # tests/fixtures_systemctl.py for the captured evidence.
    def show(self) -> tuple[bool, str, str]:
        args = ["show", UNIT_NAME]
        args += [f"--property={name}" for name in self.SHOW_PROPERTIES]
        return self._call(args)

    def daemon_reload(self) -> tuple[bool, str, str]:
        return self._call(["daemon-reload"])

    def enable(self) -> tuple[bool, str, str]:
        return self._call(["enable", UNIT_NAME])

    def disable(self) -> tuple[bool, str, str]:
        return self._call(["disable", UNIT_NAME])

    def start(self) -> tuple[bool, str, str]:
        return self._call(["start", UNIT_NAME])

    def stop(self) -> tuple[bool, str, str]:
        return self._call(["stop", UNIT_NAME])

    # restart, not `start`, everywhere an installed engine is replaced. `start`
    # does nothing to a unit that is already running, so an update would swap
    # the file on disk and leave the old process serving -- the failure
    # install.sh already carried a comment about.
    def restart(self) -> tuple[bool, str, str]:
        return self._call(["restart", UNIT_NAME])

    def reset_failed(self) -> tuple[bool, str, str]:
        return self._call(["reset-failed", UNIT_NAME])


def parse_show(text: str) -> dict[str, str]:
    """KEY=VALUE lines into a dict, tolerating everything systemd will not send.

    Blank lines, lines without '=', and empty keys are dropped rather than
    raising: this parses the output of another program, and the one thing it
    must never do is take the panel down with it.
    """
    props: dict[str, str] = {}
    for line in text[:SERVICE_OUTPUT_MAX].splitlines():
        key, sep, value = line.partition("=")
        key = key.strip()
        if not sep or not key:
            continue
        props[key] = value.strip()[:SERVICE_MESSAGE_MAX]
    return props


def _read_bytes(path: Path) -> bytes | None:
    """File contents, or None when it is absent or unreadable. Never raises."""
    try:
        return path.read_bytes()
    except OSError:
        return None


def _read_version(data: bytes | None) -> str:
    if not data:
        return ""
    try:
        head = data[:_VERSION_SCAN_BYTES].decode("utf-8", "replace")
    except Exception:  # pragma: no cover - decode with 'replace' does not raise
        return ""
    found = _VERSION_DECL.search(head)
    return found.group(1) if found else ""


def _state_age(path: Path, now: float) -> float | None:
    """Seconds since the engine last published, or None if it never has."""
    raw = read_state(path)
    if not raw or "updatedAt" not in raw:
        return None
    try:
        return now - float(raw["updatedAt"])
    except (TypeError, ValueError):
        return None


def _started_seconds_ago(props: dict[str, str], now_monotonic: float) -> float | None:
    """How long the unit has been active, from systemd's monotonic timestamp.

    ActiveEnterTimestampMonotonic is CLOCK_MONOTONIC microseconds -- the same
    clock time.clock_gettime reads -- so this needs no date parsing and no
    locale. A failed unit also carries a non-zero value (it did enter active,
    briefly), so callers must gate this on ActiveState themselves.
    """
    raw = props.get("ActiveEnterTimestampMonotonic", "")
    try:
        micros = int(raw)
    except (TypeError, ValueError):
        return None
    if micros <= 0:
        return None
    return now_monotonic - micros / 1_000_000.0


def service_status(paths: ServicePaths | None = None,
                   systemctl: Systemctl | None = None) -> dict[str, Any]:
    """What is installed, what is running, and whether they are this release.

    Reads. Never writes, never creates a directory, and never executes the
    installed engine. Three independent questions, because no one of them is
    enough on its own: state.json outlives a stopped service, systemd will call
    a wedged process active, and an installed binary can lag the checkout it
    was copied from.
    """
    paths = paths or ServicePaths.resolve()
    systemctl = systemctl or Systemctl()

    source_engine = _read_bytes(paths.source_engine)
    source_unit = _read_bytes(paths.source_unit)
    installed_engine = _read_bytes(paths.engine)
    installed_unit = _read_bytes(paths.unit)

    has_source = source_engine is not None and source_unit is not None
    installed = installed_engine is not None and installed_unit is not None

    # Bytes, not versions. A development build or a changed unit file carries
    # the same version string as the release it came from, and "the file on
    # disk is not the file in this checkout" is the question that matters.
    if not has_source:
        current = True  # unknowable from here; never claim drift we cannot see
    else:
        current = installed and installed_engine == source_engine and installed_unit == source_unit

    ok, out, message = systemctl.show()
    props = parse_show(out) if ok else {}
    active = props.get("ActiveState", "unknown") if ok else "unknown"
    enabled = props.get("UnitFileState", "") in ("enabled", "enabled-runtime")

    now = time.time()
    age = _state_age(paths.state, now)
    fresh = age is not None and age < STATE_FRESH_SECONDS

    if not installed:
        state = "not-installed"
    elif not current:
        state = "update-available"
    elif not ok:
        # systemd could not be asked. Fall back to the one piece of evidence
        # that does not need it, and say so in the message rather than
        # inventing a supervision state.
        state = "ready" if fresh else "stopped"
    elif active == "activating":
        # "activating" covers two opposite situations. A unit that is coming up
        # is starting. A unit in auto-restart has already failed and is waiting
        # out RestartSec before failing again -- and because this unit sets
        # Restart=on-failure, a crash loop never reaches "failed" at all, it
        # oscillates through activating forever. Reporting that as "starting"
        # would leave the panel saying "nearly there" for as long as the engine
        # kept dying, which is the one thing this display must never do.
        state = "unhealthy" if props.get("SubState") == "auto-restart" else "starting"
    elif active == "failed":
        # Stopped, and stopped for a reason. Restart is the repair that works
        # on a unit which hit its start limit, so this is not folded into
        # "stopped" -- the offered action differs.
        state = "unhealthy"
    elif active != "active":
        state = "stopped"
    elif fresh:
        state = "ready"
    else:
        started = _started_seconds_ago(props, time.clock_gettime(time.CLOCK_MONOTONIC))
        state = "starting" if started is not None and started < STARTUP_GRACE_SECONDS else "unhealthy"

    detail = message
    if not detail and state == "unhealthy" and props.get("SubState") == "auto-restart":
        restarts = props.get("NRestarts", "")
        detail = ("the service keeps failing and restarting"
                  + (f" ({restarts} times so far)"
                     if restarts.isdigit() and int(restarts) > 0 else ""))
    elif not detail and state == "unhealthy" and active == "failed":
        detail = f"the service failed ({props.get('Result', 'unknown')})"
    elif not detail and state == "unhealthy":
        detail = "the service is running but has not published state"
    elif not detail and not has_source:
        detail = "installed copy: cannot compare with a plugin checkout from here"

    return {
        "schema": SERVICE_SCHEMA,
        "action": "",
        "ok": True,
        "changed": False,
        "rolledBack": False,
        "rollbackFailed": False,
        "message": _sanitize(detail),
        "state": state,
        "installed": installed,
        "current": bool(current),
        "enabled": enabled,
        "activeState": active,
        "stateFresh": fresh,
        "sourceAvailable": has_source,
        "sourceVersion": VERSION if has_source else "",
        "installedVersion": _read_version(installed_engine),
        "enginePath": str(paths.engine),
        "unitPath": str(paths.unit),
    }


def _verify_running(systemctl: Systemctl, attempts: int | None = None,
                    delay: float | None = None) -> tuple[bool, str]:
    """Did the thing we just started actually stay started?

    Not "did systemctl exit 0" -- it does that for a program that cannot be
    executed at all -- and not "is ActiveState active right now", because right
    now is too soon. This keeps looking until systemd has had a chance to
    contradict itself, returns as soon as it does, and only calls a start
    successful once the unit has survived the whole window.
    """
    # Read at call time, not bound as defaults: a default argument is
    # evaluated once when this file is imported, so a test that shortened the
    # window by setting the module constant changed nothing and quietly slept
    # through the whole suite instead.
    attempts = VERIFY_ATTEMPTS if attempts is None else attempts
    delay = VERIFY_DELAY if delay is None else delay

    last_active = "unknown"
    for attempt in range(attempts):
        ok, out, message = systemctl.show()
        if not ok:
            return False, message
        props = parse_show(out)
        last_active = props.get("ActiveState", "unknown")
        sub = props.get("SubState", "")
        if sub == "auto-restart":
            # NRestarts is usually still 0 here: the unit has failed once and
            # is waiting out RestartSec before its first retry. Only mention a
            # count when there is one, rather than saying "restarting 0 times".
            restarts = props.get("NRestarts", "")
            repeated = restarts.isdigit() and int(restarts) > 0
            return False, ("the service started and immediately failed"
                           + (f", and has failed {restarts} times since" if repeated else ""))
        if last_active == "failed":
            return False, f"the service failed ({props.get('Result', 'unknown')})"
        if last_active not in ("active", "activating"):
            return False, f"the service is {last_active}"
        if attempt + 1 < attempts:
            time.sleep(delay)
    return True, ""


def _result(action: str, ok: bool, status: dict[str, Any], message: str = "",
            changed: bool = False, rolled_back: bool = False,
            rollback_failed: bool = False) -> dict[str, Any]:
    """One shape for every service command, so the panel parses one shape."""
    out = dict(status)
    out["action"] = action
    out["ok"] = ok
    out["changed"] = changed
    out["rolledBack"] = rolled_back
    out["rollbackFailed"] = rollback_failed
    if message:
        out["message"] = _sanitize(message)
    return out


@dataclass
class _Snapshot:
    """What a target looked like before we touched it. data None means absent."""

    path: Path
    data: bytes | None
    mode: int | None

    @classmethod
    def take(cls, path: Path) -> "_Snapshot":
        data = _read_bytes(path)
        mode = None
        if data is not None:
            try:
                mode = stat.S_IMODE(path.stat().st_mode)
            except OSError:
                mode = None
        return cls(path=path, data=data, mode=mode)

    def restore(self, default_mode: int) -> None:
        if self.data is None:
            self.path.unlink(missing_ok=True)
            return
        _stage(self.path, self.data, self.mode if self.mode is not None else default_mode)


def _stage(dest: Path, data: bytes, mode: int) -> None:
    """Write beside the target, flush it to disk, then rename over it.

    A half-written engine is worse than an old one, and os.replace is the only
    step here that a reader can observe. The explicit chmod is not redundant:
    os.open's mode is masked by umask, so a 0o644 unit under a 0o077 umask
    would land at 0o600 and systemd would not read it.
    """
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(f".{dest.name}.new-{os.getpid()}")
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, dest)
    except BaseException:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


def _rollback(snapshots: list[tuple[_Snapshot, int]], systemctl: Systemctl,
              was_active: bool, had_unit: bool) -> tuple[bool, str]:
    """Put back what was there. Returns (rolled_back, why_it_could_not_be).

    Order matters in one direction only: when the unit file is about to be
    removed, `disable` has to run first or its symlinks are left dangling.
    """
    problems: list[str] = []
    if not had_unit:
        for call in (systemctl.stop, systemctl.disable):
            ok, _, message = call()
            if not ok:
                problems.append(message)
    try:
        for snapshot, default_mode in snapshots:
            snapshot.restore(default_mode)
    except OSError as exc:
        return False, _sanitize(f"could not restore {exc}")

    ok, _, message = systemctl.daemon_reload()
    if not ok:
        problems.append(message)

    if had_unit:
        restore_call = systemctl.restart if was_active else systemctl.stop
        ok, _, message = restore_call()
        if not ok:
            problems.append(message)
    if not was_active:
        systemctl.reset_failed()

    # The files are back either way; the notes above are about the service,
    # and a caller that reports them has told the truth about both.
    return True, _sanitize("; ".join(p for p in problems if p))


def service_install(paths: ServicePaths | None = None,
                    systemctl: Systemctl | None = None) -> dict[str, Any]:
    """Install or update the engine and its user service, or change nothing.

    Idempotent: identical files are not rewritten, but enablement and the
    running state are still verified, because "the right bytes are on disk" is
    not the same claim as "the engine is running".
    """
    paths = paths or ServicePaths.resolve()
    systemctl = systemctl or Systemctl()

    if not paths.source_available:
        status = service_status(paths, systemctl)
        return _result("install", False, status,
                       message="run this from the plugin checkout: "
                               f"{paths.source_unit} is not there to install")

    source_engine = _read_bytes(paths.source_engine)
    source_unit = _read_bytes(paths.source_unit)
    if source_engine is None or source_unit is None:
        status = service_status(paths, systemctl)
        return _result("install", False, status,
                       message="could not read the files to install")

    before = service_status(paths, systemctl)
    was_active = before["activeState"] == "active"
    had_unit = paths.unit.exists()

    snapshots = [(_Snapshot.take(paths.engine), ENGINE_MODE),
                 (_Snapshot.take(paths.unit), UNIT_MODE)]
    changed = (snapshots[0][0].data != source_engine
               or snapshots[1][0].data != source_unit)

    if changed:
        try:
            _stage(paths.engine, source_engine, ENGINE_MODE)
            _stage(paths.unit, source_unit, UNIT_MODE)
        except OSError as exc:
            rolled, why = _rollback(snapshots, systemctl, was_active, had_unit)
            status = service_status(paths, systemctl)
            return _result("install", False, status,
                           message=_sanitize(f"could not write the files: {exc}"),
                           rolled_back=rolled, rollback_failed=not rolled or bool(why))

    for call in (systemctl.daemon_reload, systemctl.enable, systemctl.restart):
        ok, _, message = call()
        if ok:
            continue
        rolled, why = _rollback(snapshots, systemctl, was_active, had_unit)
        status = service_status(paths, systemctl)
        return _result("install", False, status, message=message,
                       rolled_back=rolled, rollback_failed=not rolled or bool(why))

    # Verify against systemd's own answer, not against the exit code of the
    # restart: a Type=simple unit whose program cannot be executed reports a
    # successful start, and reports itself active for a moment afterwards.
    # Measured; see tests/fixtures_systemctl.py and _verify_running.
    running, why_not = _verify_running(systemctl)
    if not running:
        rolled, why = _rollback(snapshots, systemctl, was_active, had_unit)
        after = service_status(paths, systemctl)
        return _result("install", False, after, message=why_not,
                       rolled_back=rolled, rollback_failed=not rolled or bool(why))
    status = service_status(paths, systemctl)

    return _result("install", True, status, changed=changed,
                   message="" if changed else "already up to date")


def _lifecycle(action: str, paths: ServicePaths, systemctl: Systemctl,
               call) -> dict[str, Any]:
    """start and restart: same shape, same verification, one verb apart."""
    status = service_status(paths, systemctl)
    if not status["installed"]:
        return _result(action, False, status,
                       message="the engine is not installed yet")

    ok, _, message = call()
    if not ok:
        return _result(action, False, service_status(paths, systemctl), message=message)

    running, why_not = _verify_running(systemctl)
    after = service_status(paths, systemctl)
    if not running:
        return _result(action, False, after, message=why_not)
    return _result(action, True, after, changed=True)


def service_start(paths: ServicePaths | None = None,
                  systemctl: Systemctl | None = None) -> dict[str, Any]:
    paths = paths or ServicePaths.resolve()
    systemctl = systemctl or Systemctl()
    return _lifecycle("start", paths, systemctl, systemctl.start)


def service_restart(paths: ServicePaths | None = None,
                    systemctl: Systemctl | None = None) -> dict[str, Any]:
    paths = paths or ServicePaths.resolve()
    systemctl = systemctl or Systemctl()
    return _lifecycle("restart", paths, systemctl, systemctl.restart)


def service_uninstall(paths: ServicePaths | None = None,
                      systemctl: Systemctl | None = None) -> dict[str, Any]:
    """Remove the engine and its unit. Keep every word you have written.

    Configuration, today's count, per-file baselines and history all survive,
    so reinstalling resumes rather than restarts. A cleanup action in a bar
    panel must not be a data-loss action, and the confirmation says as much.
    """
    paths = paths or ServicePaths.resolve()
    systemctl = systemctl or Systemctl()

    had_unit = paths.unit.exists()
    had_engine = paths.engine.exists()
    if not had_unit and not had_engine:
        return _result("uninstall", True, service_status(paths, systemctl),
                       message="nothing was installed")

    # Only when the unit is actually there. Asking systemd to stop a unit it
    # has never heard of is a failure it will report, and reporting it would
    # make a second uninstall look broken.
    if had_unit:
        for call in (systemctl.stop, systemctl.disable):
            ok, _, message = call()
            if not ok:
                # Do not delete a unit file we could not stop: that would
                # leave the process running with nothing left to stop it with.
                return _result("uninstall", False, service_status(paths, systemctl),
                               message=message)

    removed = []
    try:
        for target in (paths.engine, paths.unit):
            if target.exists():
                target.unlink()
                removed.append(target)
    except OSError as exc:
        return _result("uninstall", False, service_status(paths, systemctl),
                       message=_sanitize(f"could not remove {exc}"))

    problems = []
    for call in (systemctl.daemon_reload, systemctl.reset_failed):
        ok, _, message = call()
        if not ok and call is systemctl.daemon_reload:
            problems.append(message)

    status = service_status(paths, systemctl)
    return _result("uninstall", True, status, changed=bool(removed),
                   message="; ".join(problems))


SERVICE_ACTIONS = {
    "status": service_status,
    "install": service_install,
    "start": service_start,
    "restart": service_restart,
    "uninstall": service_uninstall,
}


def render_service(result: dict[str, Any]) -> str:
    """The terminal rendering. install.sh and uninstall.sh print this."""
    lines = []
    action = result["action"] or "status"
    if result["action"]:
        lines.append(f"{action}: " + ("ok" if result["ok"] else "FAILED"))
    lines.append(f"state         {result['state']}")
    lines.append(f"engine        {result['enginePath']}"
                 + ("" if result["installed"] else "  (not installed)"))
    lines.append(f"unit          {result['unitPath']}")
    if result["installedVersion"] or result["sourceVersion"]:
        lines.append(f"version       installed {result['installedVersion'] or '-'}"
                     f", this checkout {result['sourceVersion'] or '-'}")
    lines.append(f"service       {result['activeState']}"
                 + (", enabled" if result["enabled"] else ", not enabled"))
    if result["rolledBack"]:
        lines.append("rolled back   the previous installation was restored"
                     + (" (with problems, see below)" if result["rollbackFailed"] else ""))
    if result["message"]:
        lines.append(f"note          {result['message']}")
    return "\n".join(lines)


def cmd_service(args: argparse.Namespace) -> int:
    result = SERVICE_ACTIONS[args.service_action]()
    if args.json:
        # One line, sorted keys: the panel reads this, and a stable byte order
        # makes a diff of two probes readable to a human as well.
        print(json.dumps(result, sort_keys=True))
    else:
        print(render_service(result))
    # A probe that answered is a success even when the answer is "not
    # installed"; the state field carries that. An action that failed is not.
    return 0 if result["ok"] else 1


# ----------------------------------------------------------------- cli


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="writing-critter", description=__doc__.splitlines()[0])
    p.add_argument("--config", type=Path, default=CONFIG_PATH, help="config file (default: %(default)s)")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("run", help="run in the foreground, logging every decision")
    sub.add_parser("status", help="print today's count and why counting is or is not happening")

    svc = sub.add_parser("service", help="install, inspect and remove the user service")
    svcsub = svc.add_subparsers(dest="service_action", required=True)
    # No action takes an argument. The source is this checkout and the
    # destinations are fixed; there is deliberately nothing to pass. --json is
    # declared per action rather than on the group so that it can be written
    # last, where a reader of `service install --json` expects it.
    for action, blurb in (
        ("status", "report what is installed and whether it is running"),
        ("install", "install or update the engine and start its user service"),
        ("start", "start the installed user service"),
        ("restart", "restart the installed user service"),
        ("uninstall", "remove the engine and unit, keeping all writing data"),
    ):
        sp = svcsub.add_parser(action, help=blurb)
        sp.add_argument("--json", action="store_true",
                        help=f"print the machine-readable result object (schema {SERVICE_SCHEMA})")

    cfg = sub.add_parser("config", help="inspect and change settings")
    cfgsub = cfg.add_subparsers(dest="config_action", required=True)
    cfgsub.add_parser("show", help="print the effective configuration")
    cfgsub.add_parser("path", help="print the config file path")
    for action, meta in (("add-path", "DIR"), ("remove-path", "DIR"),
                         ("add-app", "APPID"), ("remove-app", "APPID"),
                         ("set-goal", "WORDS"), ("set-mascot", "NAME"),
                         ("set-poll", "SECONDS")):
        sp = cfgsub.add_parser(action, help=f"{action.replace('-', ' ')}")
        sp.add_argument("value", metavar=meta)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    handler = {"run": cmd_run, "status": cmd_status, "config": cmd_config,
               "service": cmd_service}[args.command]
    try:
        return handler(args)
    except ConfigError as exc:
        print(f"writing-critter: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
