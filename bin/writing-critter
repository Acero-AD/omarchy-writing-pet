#!/usr/bin/env python3
"""Writing Critter — counting engine.

Runs OUTSIDE the desktop shell, on purpose. An earlier version did this work
inside quickshell and segfaulted the whole desktop in a crash loop; see
docs/POSTMORTEM-ORPHANED-READ.md. Here, a bug is a dead script.

Standard library only. Readable on purpose too: this reads your documents, so
you should be able to audit it without trusting a dependency tree.
"""

from __future__ import annotations

import argparse
import copy
import json
import os
import re
import select
import socket
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

VERSION = "0.1.0"

# ----------------------------------------------------------------- paths


def _xdg(var: str, default: str) -> Path:
    raw = os.environ.get(var, "").strip()
    return Path(raw) if raw else Path.home() / default


CONFIG_PATH = _xdg("XDG_CONFIG_HOME", ".config") / "writing-critter" / "config.json"
STATE_PATH = _xdg("XDG_STATE_HOME", ".local/state") / "writing-critter" / "state.json"

# ----------------------------------------------------------------- config

DEFAULTS: dict[str, Any] = {
    "goal": 500,
    "watch": [],
    "extensions": [".md", ".txt"],
    "whitelist": [
        "omawrite",
        "obsidian",
        "typora",
        "soffice",
        "libreoffice-writer",
        "ghostwriter",
        "apostrophe",
    ],
    "graceSeconds": 15,
    "pollSeconds": 2,
    "lookbackSeconds": 3,
    "recountCap": 200,
    "netMode": "additive",
    "mascot": "bird",
}

POLL_MIN, POLL_MAX = 1, 30
HISTORY_MAX = 365


class ConfigError(Exception):
    """Raised when the config file exists but cannot be used."""


@dataclass
class Config:
    path: Path
    # deepcopy, not dict(): a shallow copy aliases the list values, so appending
    # a watch path would mutate DEFAULTS itself and leak into every later load.
    values: dict[str, Any] = field(default_factory=lambda: copy.deepcopy(DEFAULTS))

    @classmethod
    def load(cls, path: Path = CONFIG_PATH) -> "Config":
        cfg = cls(path=path)
        if not path.exists():
            return cfg
        try:
            raw = json.loads(path.read_text())
        except json.JSONDecodeError as exc:
            # Never rewrite a file we could not parse: the user's settings are
            # in there, and overwriting them with defaults would be worse than
            # refusing to start.
            raise ConfigError(f"{path}: invalid JSON at line {exc.lineno}, column {exc.colno}: {exc.msg}")
        if not isinstance(raw, dict):
            raise ConfigError(f"{path}: expected a JSON object, found {type(raw).__name__}")
        unknown = sorted(set(raw) - set(DEFAULTS))
        if unknown:
            raise ConfigError(f"{path}: unknown setting(s): {', '.join(unknown)}")
        cfg.values.update(raw)
        cfg.validate()
        return cfg

    def validate(self) -> None:
        v = self.values
        if not isinstance(v["goal"], int) or v["goal"] < 1:
            raise ConfigError(f"{self.path}: 'goal' must be a positive integer")
        for key in ("watch", "extensions", "whitelist"):
            if not isinstance(v[key], list) or not all(isinstance(x, str) for x in v[key]):
                raise ConfigError(f"{self.path}: '{key}' must be a list of strings")
        if v["netMode"] not in ("additive", "net"):
            raise ConfigError(f"{self.path}: 'netMode' must be 'additive' or 'net'")

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(self.path, json.dumps(self.values, indent=2, sort_keys=True) + "\n")

    # convenience accessors -------------------------------------------------
    @property
    def poll_seconds(self) -> int:
        return max(POLL_MIN, min(POLL_MAX, int(self.values["pollSeconds"])))

    @property
    def lookback_seconds(self) -> int:
        """Must exceed the poll interval or a save on a tick boundary is missed."""
        want = int(self.values["lookbackSeconds"])
        return want if want > self.poll_seconds else self.poll_seconds + 1

    @property
    def watch_paths(self) -> list[Path]:
        return [Path(os.path.expanduser(p)) for p in self.values["watch"]]


# ----------------------------------------------------------------- atomic io


def write_atomic(path: Path, text: str) -> None:
    """Write via temporary file and rename, so a reader never sees a torn file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# ----------------------------------------------------------------- logging


class Log:
    """Every decision, on stdout, in order. The previous implementation was
    undiagnosable precisely because it made decisions silently."""

    def __init__(self, enabled: bool = True) -> None:
        self.enabled = enabled

    def __call__(self, event: str, **fields: Any) -> None:
        if not self.enabled:
            return
        stamp = time.strftime("%H:%M:%S")
        detail = " ".join(f"{k}={v}" for k, v in fields.items())
        print(f"{stamp} {event}" + (f"  {detail}" if detail else ""), flush=True)


# ----------------------------------------------------------------- counting

# CJK scripts do not delimit words with spaces, so whitespace splitting would
# score a whole paragraph as one word. Counting each ideograph overshoots -- most
# words are one or two characters -- but it is stable and predictable, which
# matters more for a progress bar than linguistic accuracy. Documented as a
# known approximation.
CJK = re.compile(
    "[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uff66-\uff9f]"
)


def count_words(text: str) -> int:
    if not text:
        return 0
    cjk = len(CJK.findall(text))
    return len(CJK.sub(" ", text).split()) + cjk


@dataclass
class FileRecord:
    """base  — word count when the day started, or when first seen
    last  — most recently observed count
    peak  — high-water mark of (last - base) today"""

    base: int
    last: int
    peak: int = 0


class Tracker:
    """Today's total is the sum of per-file high-water marks.

    That is re-derived from stored numbers rather than accumulated, so counting
    an unchanged file twice is a no-op and an overlapping scan window cannot
    double-count. The high-water mark also means cutting a paragraph never takes
    back progress already earned -- a counter that falls when you edit teaches
    you not to edit.
    """

    def __init__(self, files: dict[str, FileRecord] | None = None) -> None:
        self.files: dict[str, FileRecord] = files or {}

    def seed(self, path: str, words: int) -> None:
        """Record a pre-existing file's count as its baseline, contributing zero.

        This is how pointing the engine at a vault full of old notes adds
        nothing to today. It is deliberately separate from observe(): a file
        that appears *after* seeding was written while we were watching, and
        every word of it counts.
        """
        words = max(0, int(words))
        if path not in self.files:
            self.files[path] = FileRecord(base=words, last=words, peak=0)

    def observe(self, path: str, words: int, net_mode: str = "additive") -> None:
        words = max(0, int(words))
        record = self.files.get(path)
        if record is None:
            # Unseen at this point means created since seeding: you wrote it, so
            # all of it counts. Pre-existing files were given a baseline by
            # seed() before the first cycle ran.
            self.files[path] = FileRecord(base=0, last=words, peak=words if net_mode != "net" else words)
            return
        record.last = words
        delta = words - record.base
        if net_mode == "net":
            record.peak = delta
        else:
            record.peak = max(record.peak, delta, 0)

    def forget(self, path: str) -> None:
        self.files.pop(path, None)

    def rebase(self, path: str) -> None:
        record = self.files.get(path)
        if record is not None:
            record.base, record.peak = record.last, 0

    def total(self) -> int:
        return max(0, sum(r.peak for r in self.files.values()))

    def carry_forward(self) -> "Tracker":
        """New day: today's counts become tomorrow's baselines."""
        return Tracker({p: FileRecord(base=r.last, last=r.last, peak=0) for p, r in self.files.items()})

    def to_json(self) -> dict[str, list[int]]:
        return {p: [r.base, r.last, r.peak] for p, r in self.files.items()}

    @classmethod
    def from_json(cls, raw: Any) -> "Tracker":
        files: dict[str, FileRecord] = {}
        if isinstance(raw, dict):
            for path, triple in raw.items():
                if isinstance(triple, list) and len(triple) == 3 and all(isinstance(n, int) for n in triple):
                    files[path] = FileRecord(*triple)
        return cls(files)


def scan(paths: list[Path], extensions: list[str], cutoff: float, log: Log) -> list[Path]:
    """Metadata-only: stat every candidate, read none.

    Deliberately in-process. The previous version shelled out to `find` with a
    relative timestamp, which GNU findutils accepts and bfs -- what Omarchy
    ships -- rejects outright, so the scan errored every cycle and counted
    nothing, silently.
    """
    suffixes = tuple(extensions)
    changed: list[Path] = []

    # os.scandir over os.walk + Path(): DirEntry carries stat data from the
    # directory read, and building a Path per candidate cost more than the scan
    # itself. This loop runs every couple of seconds forever, so it is worth it.
    def descend(directory: str) -> None:
        try:
            entries = list(os.scandir(directory))
        except OSError as exc:
            log("scan.failed", path=directory, error=exc)
            return
        for entry in entries:
            try:
                if entry.is_dir(follow_symlinks=False):
                    if not entry.name.startswith(".") and entry.name != "node_modules":
                        descend(entry.path)
                elif entry.name.endswith(suffixes) and entry.stat().st_mtime > cutoff:
                    changed.append(Path(entry.path))
            except OSError as exc:
                log("scan.stat_failed", path=entry.path, error=exc)

    for root in paths:
        descend(str(root))
    return changed


# ----------------------------------------------------------------- focus
#
# The ONLY compositor-specific code in the engine. Everything else works from
# the plain app-id string this yields, so porting to another compositor means
# replacing this class and nothing else.
#
# Requires Hyprland. Omarchy is Hyprland, so the practical cost is nil. The
# in-shell version used Wayland's ToplevelManager, which does not exist outside
# quickshell -- and the event stream is the better fit anyway: it costs nothing
# while idle, where the old design needed a polling fallback.


class HyprlandFocus:
    EVENT = "activewindow>>"

    def __init__(self, log: Log) -> None:
        self.log = log
        self._buffer = ""

    def socket_path(self) -> Path | None:
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not runtime or not signature:
            return None
        candidate = Path(runtime) / "hypr" / signature / ".socket2.sock"
        return candidate if candidate.exists() else None

    def current(self) -> str:
        """Focus at startup.

        Without this the engine never starts when it is launched with the editor
        already focused: no transition arrives, so an event-only design waits
        forever. That exact bug shipped in the in-shell version.
        """
        try:
            out = subprocess.run(
                ["hyprctl", "activewindow", "-j"],
                capture_output=True, text=True, timeout=5, check=False,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            self.log("focus.query_failed", error=exc)
            return ""
        if out.returncode != 0:
            self.log("focus.query_failed", status=out.returncode, stderr=out.stderr.strip()[:120])
            return ""
        try:
            return str(json.loads(out.stdout or "{}").get("class", "") or "")
        except json.JSONDecodeError:
            self.log("focus.query_unparseable")
            return ""

    def connect(self) -> socket.socket | None:
        """Open the event stream. Returned so the caller can select() on it and
        drive its own cadence from the same loop -- no threads, no polling."""
        path = self.socket_path()
        if path is None:
            self.log("focus.no_socket", hint="HYPRLAND_INSTANCE_SIGNATURE unset or socket missing")
            return None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(str(path))
        self._buffer = ""
        return sock

    def drain(self, sock: socket.socket) -> list[str]:
        """Return the app id from each focus change now readable, in order."""
        chunk = sock.recv(65536)
        if not chunk:
            raise ConnectionError("hyprland event stream closed")
        self._buffer += chunk.decode("utf-8", errors="replace")
        out = []
        while "\n" in self._buffer:
            line, self._buffer = self._buffer.split("\n", 1)
            if line.startswith(self.EVENT):
                # "activewindow>>CLASS,TITLE"; a title may itself contain commas.
                out.append(line[len(self.EVENT):].split(",", 1)[0])
        return out


# ----------------------------------------------------------------- matching
#
# Wayland app ids are often reverse-DNS ("md.obsidian.Obsidian") while people
# think in short names ("obsidian"). Exact matching means a whitelist that looks
# obviously correct silently matches nothing and the critter never wakes -- the
# real bug that made the in-shell version look broken for a whole session.


def app_matches(entry: str, app_id: str) -> bool:
    if not entry or not app_id:
        return False
    e, a = entry.lower(), app_id.lower()
    if e == a:
        return True
    if "." in e:
        return False  # a dotted entry is a deliberate exact match
    _, dot, leaf = a.rpartition(".")
    return bool(dot) and leaf == e


def app_in_list(entries: list[str], app_id: str) -> bool:
    return any(app_matches(e, app_id) for e in entries)


# ----------------------------------------------------------------- engine


class Engine:
    def __init__(self, config: Config, log: Log) -> None:
        self.config = config
        self.log = log
        self.focused_app: str = ""
        self.last_writing_at: float = 0.0
        self._gate_open: bool = False
        self.state_path: Path = STATE_PATH
        self.today: str = local_date()
        self.history: list[dict[str, Any]] = []
        self.tracker: Tracker = Tracker()
        self.words: int = 0

    # ---- the gate: the whole activation model, a pure function of focus ----

    def writing_focused(self) -> bool:
        return app_in_list(self.config.values["whitelist"], self.focused_app)

    def gate_open(self, now: float | None = None) -> bool:
        """Open while a writing app is focused, or was within the grace window.

        The grace exists because editors autosave a beat after focus leaves; a
        strict gate drops the save that finishes just after you alt-tab.
        """
        if self.blocking_reason():
            return False
        if self.writing_focused():
            return True
        now = time.time() if now is None else now
        grace = float(self.config.values["graceSeconds"])
        return self.last_writing_at > 0 and (now - self.last_writing_at) < grace

    def set_focus(self, app_id: str, now: float | None = None) -> bool:
        """Record a focus change. Returns True if the gate state changed."""
        now = time.time() if now is None else now
        was_open = self._gate_open
        moved = app_id != self.focused_app
        self.focused_app = app_id
        if self.writing_focused():
            self.last_writing_at = now
        self._gate_open = self.gate_open(now)
        if self._gate_open != was_open:
            self.log("gate." + ("open" if self._gate_open else "closed"), app=app_id or "(none)")
            return True
        # Hyprland re-emits activewindow on title changes, and editors rewrite
        # their title as you type. Only an actual change of app is worth a line.
        if moved:
            state = "open" if self._gate_open else "closed"
            if self._gate_open and not self.writing_focused():
                state = "open (grace)"
            self.log("focus.change", app=app_id or "(none)", gate=state)
        return False

    def refresh_gate(self, now: float | None = None) -> bool:
        """Re-evaluate without a focus change, so the grace window can expire."""
        now = time.time() if now is None else now
        was_open = self._gate_open
        self._gate_open = self.gate_open(now)
        if self._gate_open != was_open:
            self.log("gate." + ("open" if self._gate_open else "closed"), reason="grace expired")
        return self._gate_open

    # ------------------------------------------------------------- state

    def load_state(self, path: Path = None) -> None:
        path = STATE_PATH if path is None else path
        self.state_path = path
        raw = read_state(path) or {}
        self.today = str(raw.get("date") or local_date())
        self.history = raw.get("history") if isinstance(raw.get("history"), list) else []
        self.tracker = Tracker.from_json(raw.get("tracking"))
        self.words = self.tracker.total()
        self.check_rollover()

    def write_state(self) -> None:
        payload = {
            "schema": 1,
            "date": self.today,
            "goal": int(self.config.values["goal"]),
            "wordsToday": self.words,
            "byOrigin": {"filewatch": self.words},
            "history": self.history[-HISTORY_MAX:],
            "mascot": self.config.values["mascot"],
            "gateOpen": self._gate_open,
            "updatedAt": time.time(),
            "tracking": self.tracker.to_json(),
        }
        write_atomic(self.state_path, json.dumps(payload, indent=2, sort_keys=True) + "\n")

    def check_rollover(self, today: str | None = None) -> bool:
        today = local_date() if today is None else today
        if today == self.today:
            return False
        self.history = (self.history + [
            {"date": self.today, "words": self.words, "goal": int(self.config.values["goal"])}
        ])[-HISTORY_MAX:]
        # Baselines carry forward, so yesterday's words are never re-counted and
        # no file has to be re-read at midnight.
        self.tracker = self.tracker.carry_forward()
        self.today = today
        self.words = 0
        self.log("day.rollover", date=today, archived=len(self.history))
        return True

    def seed_baselines(self) -> int:
        """Give every file already on disk a baseline, so existing writing is
        not counted as today's. Runs once at startup; a file appearing after
        this counts in full."""
        seeded = 0
        for path in scan(self.config.watch_paths, self.config.values["extensions"], -1.0, self.log):
            key = str(path)
            if key in self.tracker.files:
                continue
            try:
                self.tracker.seed(key, count_words(path.read_text(errors="replace")))
                seeded += 1
            except OSError as exc:
                self.log("seed.read_failed", path=path, error=exc)
        if seeded:
            self.log("seed.baselines", files=seeded)
        return seeded

    # ------------------------------------------------------------- cycle

    def cycle(self) -> None:
        self.check_rollover()
        cutoff = time.time() - self.config.lookback_seconds
        changed = scan(self.config.watch_paths, self.config.values["extensions"], cutoff, self.log)
        if not changed:
            return

        cap = int(self.config.values["recountCap"])
        if len(changed) > cap:
            # Bound a pathological cycle: a branch switch or a bulk import
            # inside a watch directory must not turn one tick into thousands of
            # reads.
            self.log("cycle.capped", found=len(changed), cap=cap)
            changed = changed[:cap]

        before = self.words
        for path in changed:
            try:
                text = path.read_text(errors="replace")
            except OSError as exc:
                self.log("cycle.read_failed", path=path, error=exc)
                continue
            self.tracker.observe(str(path), count_words(text), self.config.values["netMode"])

        self.words = self.tracker.total()
        self.write_state()
        if self.words != before:
            self.log("words.counted", added=self.words - before, today=self.words,
                     goal=self.config.values["goal"], files=len(changed))

    def blocking_reason(self) -> str | None:
        """Why counting cannot happen right now, or None if it can."""
        if not self.config.values["watch"]:
            return "no watch paths configured (writing-critter config add-path <dir>)"
        if not self.config.values["whitelist"]:
            return "no writing apps configured (writing-critter config add-app <id>)"
        return None


# ----------------------------------------------------------------- commands


def cmd_run(args: argparse.Namespace) -> int:
    config = Config.load(args.config)
    log = Log(enabled=True)
    engine = Engine(config, log)
    log("engine.start", version=VERSION, config=config.path, state=STATE_PATH)

    blocked = engine.blocking_reason()
    if blocked:
        log("engine.blocked", reason=blocked)
        print(f"\nnot counting: {blocked}", file=sys.stderr)
        return 1

    engine.load_state()
    engine.seed_baselines()
    focus = HyprlandFocus(log)
    engine.set_focus(focus.current())
    log("engine.ready", goal=config.values["goal"], paths=len(config.watch_paths),
        poll=config.poll_seconds, lookback=config.lookback_seconds)

    sock = focus.connect()
    if sock is None:
        print("\nno Hyprland event socket; is HYPRLAND_INSTANCE_SIGNATURE set?", file=sys.stderr)
        return 1

    # One loop drives both: focus events wake it, and the select timeout
    # provides the counting cadence. No threads, and nothing polls the
    # compositor.
    try:
        with sock:
            while True:
                readable, _, _ = select.select([sock], [], [], config.poll_seconds)
                if readable:
                    for app_id in focus.drain(sock):
                        engine.set_focus(app_id)
                    continue
                if engine.refresh_gate():
                    engine.cycle()
    except ConnectionError as exc:
        log("engine.stop", reason=exc)
        return 1
    except KeyboardInterrupt:
        log("engine.stop", reason="interrupted")
        return 0


def cmd_status(args: argparse.Namespace) -> int:
    config = Config.load(args.config)
    state = read_state()

    goal = config.values["goal"]
    words = int(state.get("wordsToday", 0)) if state else 0
    print(f"words today   {words} / {goal}")
    print(f"config        {config.path}")
    print(f"state         {STATE_PATH}" + ("" if state else "  (not written yet)"))

    paths = config.values["watch"]
    print(f"watching      {', '.join(paths) if paths else '(nothing)'}")
    print(f"writing apps  {', '.join(config.values['whitelist'])}")

    if state and "updatedAt" in state:
        age = int(time.time() - float(state["updatedAt"]))
        fresh = "running" if age < 60 else f"stale ({age}s since last update)"
        print(f"engine        {fresh}")
    else:
        print("engine        not running")

    engine = Engine(config, Log(enabled=False))
    blocked = engine.blocking_reason()
    if blocked:
        print(f"\nnot counting: {blocked}")
    return 0


def local_date() -> str:
    return time.strftime("%Y-%m-%d")


def read_state(path: Path = None) -> dict[str, Any] | None:
    """Readers tolerate a missing or torn file; neither is an error."""
    try:
        return json.loads((STATE_PATH if path is None else path).read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def cmd_config(args: argparse.Namespace) -> int:
    config = Config.load(args.config)

    if args.config_action == "show":
        print(json.dumps(config.values, indent=2, sort_keys=True))
        return 0

    if args.config_action == "path":
        print(config.path)
        return 0

    key = {"add-path": "watch", "remove-path": "watch",
           "add-app": "whitelist", "remove-app": "whitelist"}[args.config_action]
    value = args.value
    if args.config_action.startswith("add"):
        if key == "watch":
            value = str(Path(os.path.expanduser(value)).resolve())
        if value in config.values[key]:
            print(f"already present: {value}")
            return 0
        config.values[key].append(value)
    else:
        if key == "watch":
            candidates = {value, str(Path(os.path.expanduser(value)).resolve())}
            before = list(config.values[key])
            config.values[key] = [p for p in before if p not in candidates]
            if config.values[key] == before:
                print(f"not present: {value}", file=sys.stderr)
                return 1
        else:
            if value not in config.values[key]:
                print(f"not present: {value}", file=sys.stderr)
                return 1
            config.values[key].remove(value)

    config.validate()
    config.save()
    print(f"{key}: {', '.join(config.values[key]) or '(empty)'}")
    return 0


# ----------------------------------------------------------------- cli


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="writing-critter", description=__doc__.splitlines()[0])
    p.add_argument("--config", type=Path, default=CONFIG_PATH, help="config file (default: %(default)s)")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("run", help="run in the foreground, logging every decision")
    sub.add_parser("status", help="print today's count and why counting is or is not happening")

    cfg = sub.add_parser("config", help="inspect and change settings")
    cfgsub = cfg.add_subparsers(dest="config_action", required=True)
    cfgsub.add_parser("show", help="print the effective configuration")
    cfgsub.add_parser("path", help="print the config file path")
    for action, meta in (("add-path", "DIR"), ("remove-path", "DIR"),
                         ("add-app", "APPID"), ("remove-app", "APPID")):
        sp = cfgsub.add_parser(action, help=f"{action.replace('-', ' ')}")
        sp.add_argument("value", metavar=meta)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    handler = {"run": cmd_run, "status": cmd_status, "config": cmd_config}[args.command]
    try:
        return handler(args)
    except ConfigError as exc:
        print(f"writing-critter: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
